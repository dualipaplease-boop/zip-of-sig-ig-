{
  "name": "sentry-agent-extension",
  "version": "2.6.0",
  "description": "On-Device Privacy-Preserving Browser Agent for SIH26171 (ISRO)",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build",
    "test": "node --test ../testbed/automated-tests/privacy.test.mjs",
    "test:unit": "node --test ../testbed/automated-tests/privacy.test.mjs ../testbed/automated-tests/accuracy-benchmark.test.mjs",
    "test:e2e": "node --test ../testbed/automated-tests/e2e-plan.test.mjs",
    "test:integration": "node --test ../testbed/automated-tests/autonomous-canvas-vision.test.mjs",
    "test:all": "node --test ../testbed/automated-tests/privacy.test.mjs ../testbed/automated-tests/accuracy-benchmark.test.mjs ../testbed/automated-tests/e2e-plan.test.mjs ../testbed/automated-tests/autonomous-canvas-vision.test.mjs",
    "test:playwright": "node ../testbed/automated-tests/playwright-audit.mjs",
    "test:server": "python3 -m unittest discover -s ../server -p \"test_*.py\""
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "@types/node": "^22.0.0",
    "playwright": "^1.63.0",
    "typescript": "^5.5.0",
    "vite": "^7.1.0"
  },
  "dependencies": {
    "onnxruntime-web": "^1.30.0"
  }
}
